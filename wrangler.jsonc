{
  "name": "splitty",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "splitty.chat", "custom_domain": true },
    { "pattern": "www.splitty.chat", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitty",
      "database_id": "f37c785c-5c42-40a5-b76b-7cb2ed6f7f0a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "splitty-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "vars": {
    "EMAIL_FROM": "splitty <no-reply@splitty.chat>",
    "ADMIN_EMAIL": "joshua@huttj.com,squashai@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
